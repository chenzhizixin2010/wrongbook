<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      真正的配色由 Compose 的 CupertinoTheme 控制，这里只负责窗口层面的样式：
      极光画布的浅色底 + 透明系统栏，避免冷启动时闪一下纯白。
    -->
    <style name="Theme.WrongBook" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F3F5FB</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
